{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shriram28Baskar/provecode/engine/schema/report.v2.json",
  "title": "PROVECODE report, schema version 2",
  "description": "The canonical JSON report produced by provecode.pipeline.run (check, guard, record, rerun and the browser). Version 2 adds the harness and test-body rules (ADR 0012), execution findings and evidence from the trusted re-run (ADR 0013).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "outcome", "reasons", "condition_status", "contract", "contract_base", "summary",
               "findings", "evidence", "gaps", "files", "provenance"],
  "properties": {
    "schema_version": {"const": "2"},
    "mode": {"enum": ["static", "live", "precomputed", "recorded"]},
    "outcome": {"enum": ["VERIFIED", "FAILED", "INCONCLUSIVE"]},
    "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
    "condition_status": {"type": "object", "additionalProperties": {"enum": ["pass", "fail", "gap"]}},
    "contract": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/contract"}]},
    "contract_base": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
                                                  "required": ["version", "content_hash"],
                                                  "properties": {"version": {"type": "integer", "minimum": 1},
                                                                 "content_hash": {"$ref": "#/$defs/hash"}}}]},
    "summary": {"type": "object", "additionalProperties": false,
                "required": ["files_analyzed", "findings_by_severity", "gaps", "evidence"],
                "properties": {"files_analyzed": {"type": "integer", "minimum": 0},
                               "findings_by_severity": {"type": "object",
                                                        "additionalProperties": {"type": "integer", "minimum": 1}},
                               "gaps": {"type": "integer", "minimum": 0},
                               "evidence": {"type": "integer", "minimum": 0}}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "files": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                         "required": ["file", "tests_base", "tests_head"],
                                         "properties": {"file": {"type": "string"},
                                                        "tests_base": {"type": "integer", "minimum": 0},
                                                        "tests_head": {"type": "integer", "minimum": 0}}}},
    "provenance": {"type": "object", "required": ["engine_version", "python", "limits"],
                   "properties": {"engine_version": {"type": "string"}, "python": {"type": "string"},
                                  "limits": {"type": "object"}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rule": {"enum": ["S1", "S2", "S3", "S4", "S5", "B1", "B2", "B3", "B4", "V0", "R0", "CONTRACT_TOUCHED",
                      "H1", "H2", "H3", "H4", "H5", "H6", "H7", "T1", "T2", "T3", "T4", "T5",
                      "X1", "X2", "X3", "X4", "X5", "X6"]},
    "lines": {"anyOf": [{"type": "null"},
                        {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2}]},
    "finding": {"type": "object", "additionalProperties": false,
                "required": ["id", "rule", "title", "file", "test", "rationale", "severity", "condition_ids",
                             "base_lines", "head_lines", "before", "after", "detail"],
                "properties": {"id": {"type": "string", "pattern": "^F[0-9]+$"}, "rule": {"$ref": "#/$defs/rule"},
                               "title": {"type": "string"}, "file": {"type": "string"},
                               "test": {"type": ["string", "null"]}, "rationale": {"type": "string", "minLength": 1},
                               "severity": {"enum": ["blocking", "warning", "info"]},
                               "condition_ids": {"type": "array", "items": {"type": "string"}},
                               "base_lines": {"$ref": "#/$defs/lines"}, "head_lines": {"$ref": "#/$defs/lines"},
                               "before": {"type": ["string", "null"]}, "after": {"type": ["string", "null"]},
                               "detail": {"type": "object"}}},
    "evidence": {"type": "object", "additionalProperties": false,
                 "required": ["id", "check_id", "condition_ids", "owner", "result", "exit_code", "output_excerpt",
                              "output_sha256", "command", "duration_s"],
                 "properties": {"id": {"type": "string"}, "check_id": {"type": "string"},
                                "condition_ids": {"type": "array", "items": {"type": "string"}},
                                "owner": {"enum": ["contract", "repo"]},
                                "result": {"enum": ["pass", "fail", "error", "expectation_changed"]},
                                "exit_code": {"type": ["integer", "null"]}, "output_excerpt": {"type": "string"},
                                "output_sha256": {"type": "string"}, "command": {"type": "string"},
                                "duration_s": {"type": ["number", "null"]}}},
    "gap": {"type": "object", "additionalProperties": false, "required": ["reason", "detail", "file", "condition_id"],
            "properties": {"reason": {"type": "string", "minLength": 1}, "detail": {"type": "string"},
                           "file": {"type": ["string", "null"]}, "condition_id": {"type": ["string", "null"]}}},
    "reason": {"type": "object", "required": ["kind", "id", "text"],
               "properties": {"kind": {"enum": ["finding", "evidence", "gap", "verified"]}, "id": {"type": "string"},
                              "text": {"type": "string"},
                              "condition_ids": {"type": "array", "items": {"type": ["string", "null"]}}}},
    "contract": {"type": "object", "additionalProperties": false,
                 "required": ["id", "version", "content_hash", "approved_by", "approved_at", "conditions"],
                 "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1},
                                "content_hash": {"$ref": "#/$defs/hash"}, "approved_by": {"type": ["string", "null"]},
                                "approved_at": {"type": ["string", "null"]},
                                "conditions": {"type": "array", "items": {"type": "object"}}}}
  }
}
